# THAKSAAI Frontend — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── Web3Forms (Email Notifications) ──────────────────────────────────────────
# Get your key at: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# ─── WhatsApp Notifications (CallMeBot) ───────────────────────────────────────
# Leave empty until you have a CallMeBot API key.
# Get your key: https://www.callmebot.com/blog/free-api-whatsapp-messages/
VITE_CALLMEBOT_API_KEY=

# ─── Admin Contact ────────────────────────────────────────────────────────────
VITE_ADMIN_PHONE=919494808669

# ─── Supabase (LMS Backend + Image Storage) ───────────────────────────────────
# Get these from your Supabase project settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=assets

# ─── Backend API (Dashboard / Auth / Courses) ─────────────────────────────────
# Point this to your Node.js/Express backend in production.
VITE_API_URL=http://localhost:5000/api
