# THAKSAAI frontend — copy to .env.local for local development.
# Never put server-side secrets (SMTP passwords, JWT secrets, CallMeBot API keys,
# database passwords, or Supabase service-role keys) in VITE_* variables.

# Optional backend origin. In production, set this to the deployed backend API base
# including /api, for example: https://your-backend.example.com/api
# Do not use the example URL as a real endpoint.
VITE_API_URL=http://localhost:5000/api

# Public destination inbox for the contact form's browser-side FormSubmit integration.
# This value is visible in the built frontend. Put only the recipient email here,
# never a Gmail password, App Password, SMTP credential, or other secret.
VITE_CONTACT_EMAIL=thaksaaicarrerplanet@gmail.com

# Optional public browser form key. This is designed for client-side use.
# If neither VITE_API_URL nor this key is configured, the form displays an explicit error.
VITE_WEB3FORMS_ACCESS_KEY=

# Supabase public project configuration (the anon key is not a service-role secret).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=assets
