# Copy to apps/backend/.env locally. Never commit the real .env file.
PORT=5000

# Existing SMTP configuration in apps/backend/src/utils/sendMail.js
GMAIL=
PASSWORD=

# Database connection
DATABASE_URL=

# Comma-separated exact origins allowed by backend CORS.
# Add the approved Vercel preview origin here when testing cross-origin API calls.
FRONTEND_ORIGINS=http://localhost:5173

# Optional server-only WhatsApp notification; never expose these as VITE_* variables.
CALLMEBOT_API_KEY=
WHATSAPP_ADMIN_PHONE=
